    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
    </Found>
    <NotFound>
        <JobScreener.Web.Components.Layout.MainLayout><p>Page not found.</p></JobScreener.Web.Components.Layout.MainLayout>
    </NotFound>
</Router>
